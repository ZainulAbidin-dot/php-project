<script>
function filterFacilities() {
    const query = document.getElementById('search-query').value.toLowerCase();
    const facilityCards = document.querySelectorAll('.facility-card');

    facilityCards.forEach(card => {
        const title = card.getAttribute('data-title').toLowerCase();
        const category = card.getAttribute('data-category').toLowerCase();
        const houseNumber = card.getAttribute('data-house-number').toLowerCase();
        const postCode = card.getAttribute('data-post-code').toLowerCase();

        if (
            title.includes(query) ||
            category.includes(query) ||
            houseNumber.includes(query) ||
            postCode.includes(query)
        ) {
            card.style.display = '';
        } else {
            card.style.display = 'none';
        }
    });
}
</script>

<script>
let nextPage = 2;
const loadMoreBtn = document.getElementById('load-more-btn');
const facilityList = document.getElementById('facility-list');

loadMoreBtn.addEventListener('click', function() {
    loadMoreBtn.disabled = true;
    loadMoreBtn.textContent = 'Loading...';
    fetch(`/api/facility.php?page=${nextPage}`)
        .then(response => response.json())
        .then(data => {
            if (Array.isArray(data.data)) {
                data.data.forEach(facility => {
                    const card = document.createElement('div');
                    card.className = 'facility-card';
                    card.setAttribute('data-title', facility.title);
                    card.setAttribute('data-category', facility.category);
                    card.setAttribute('data-house-number', facility.houseNumber);
                    card.setAttribute('data-post-code', facility.postcode);
                    card.innerHTML = `
                        <h3>${escapeHtml(facility.title)}</h3>
                        <p><strong>Category:</strong> ${escapeHtml(facility.category)}</p>
                        <p><strong>Description:</strong> ${escapeHtml(facility.description)}</p>
                        <p><strong>Location:</strong> ${escapeHtml(facility.houseNumber)}, ${escapeHtml(facility.streetName)}, ${escapeHtml(facility.town)}, ${escapeHtml(facility.postcode)}</p>
                        <p><strong>Contributor:</strong> ${escapeHtml(facility.contributor)}</p>
                        <a class="button" href="/facility.view.php?facilityId=${encodeURIComponent(facility.id)}">View</a>
                    `;
                    facilityList.appendChild(card);
                });
            }
            if (data.nextPage === -1) {
                loadMoreBtn.style.display = 'none';
            } else {
                nextPage = data.nextPage;
                loadMoreBtn.disabled = false;
                loadMoreBtn.textContent = 'Load More';
            }
        })
        .catch(() => {
            loadMoreBtn.disabled = false;
            loadMoreBtn.textContent = 'Load More';
            alert('Failed to load more facilities.');
        });
});

// Simple HTML escape to prevent XSS
function escapeHtml(text) {
    return String(text)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}
</script>

