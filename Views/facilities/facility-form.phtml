<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Facility</title>
  <link rel="stylesheet" href="/Views/styles/facility-form.css" />
  <link rel="stylesheet" href="/Views/styles/dashboard.css" />
</head>
<body>
  <header>
    <nav>
      <div class="logo">ecoBuddy</div>
      <button class="menu-toggle" aria-label="Toggle navigation">&#9776;</button>
      <ul class="nav-links">
        <li><a href="/categories.php">Categories</a></li>
        <li><a href="/dashboard.php">Facilities</a></li>
        <li><a href="/index.php">Logout</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <h1>Facility Form</h1>
    <form id="facilityForm" method="POST" action="/facility.php">
      <input type="hidden" id="id" name="id" />

      <label for="title">Title:</label>
      <input type="text" id="title" name="facilityName" maxlength="50" required /><br /><br />

      <label for="category">Category:</label>
      <select id="category" name="facilityCategory" required>
        <option value="">Select Category</option>
      </select><br /><br />

      <label for="description">Description:</label>
      <textarea id="description" name="facilityDescription" maxlength="150" required></textarea><br /><br />

      <label for="houseNumber">House Number:</label>
      <input type="text" id="houseNumber" name="houseNumber" maxlength="50" /><br /><br />

      <label for="streetName">Street Name:</label>
      <input type="text" id="streetName" name="streetName" maxlength="50" /><br /><br />

      <label for="county">County:</label>
      <input type="text" id="county" name="county" maxlength="50" /><br /><br />

      <label for="town">Town:</label>
      <input type="text" id="town" name="town" maxlength="50" /><br /><br />

      <label for="postcode">Postcode:</label>
      <input type="text" id="postcode" name="postcode" maxlength="7" required /><br /><br />

      <label for="lng">Longitude:</label>
      <input type="number" id="lng" name="longitude" step="0.0000001" required /><br /><br />

      <label for="lat">Latitude:</label>
      <input type="number" id="lat" name="latitude" step="0.0000001" required /><br /><br />

      <button type="submit">Submit</button>
    </form>
  </main>

  <footer>
    <p>&copy; 2025 ecoBuddy. All rights reserved.</p>
  </footer>

  <script>
    
    const facilities = [
      {
        id: 1,
        title: "Bike Rack at Library",
        category: "Transportation",
        description: "Secure bike parking near the city library",
        houseNumber: 10,
        streetName: "Main Street",
        county: "Central County",
        town: "Green Town",
        postcode: "M50 ABC",
        longitude: -0.1276,
        latitude: 51.5074,
        contributor: "John Doe"
      },
      {
        id: 2,
        title: "Solar Bench at Park",
        category: "Energy",
        description: "Solar-powered bench with charging ports",
        houseNumber: 15,
        streetName: "Park Lane",
        county: "West County",
        town: "Eco City",
        postcode: "SW1A 1AA",
        longitude: -0.1419,
        latitude: 51.5014,
        contributor: "Jane Smith"
      },
      {
        id: 3,
        title: "EV Charger - Downtown",
        category: "Energy",
        description: "Electric vehicle charging station in downtown",
        houseNumber: 20,
        streetName: "High Street",
        county: "East County",
        town: "Urban Ville",
        postcode: "EC2A 3LT",
        longitude: -0.0877,
        latitude: 51.5155,
        contributor: "Alex Brown"
      }
    ];

    const categories = ['Transportation', 'Energy', 'Waste', 'Water'];
    const contributors = ['John Doe', 'Jane Smith', 'Alex Brown', 'Sam Green'];

    const menuToggle = document.querySelector('.menu-toggle');
    const navLinks = document.querySelector('.nav-links');
    menuToggle.addEventListener('click', () => {
      navLinks.classList.toggle('active');
    });

    const getQueryParam = (param) => new URLSearchParams(window.location.search).get(param);
    const facilityId = getQueryParam('id');

    // Populate dropdowns
    function populateDropdown(id, list) {
      const select = document.getElementById(id);
      list.forEach(item => {
        const option = document.createElement('option');
        option.value = item;
        option.textContent = item;
        select.appendChild(option);
      });
    }

    populateDropdown('category', categories);
    populateDropdown('contributor', contributors);

    if (facilityId) {
      const facility = facilities.find(f => f.id === parseInt(facilityId));
      if (facility) {
        document.getElementById('id').value = facility.id;
        document.getElementById('title').value = facility.title;
        document.getElementById('category').value = facility.category;
        document.getElementById('description').value = facility.description;
        document.getElementById('houseNumber').value = facility.houseNumber;
        document.getElementById('streetName').value = facility.streetName;
        document.getElementById('county').value = facility.county;
        document.getElementById('town').value = facility.town;
        document.getElementById('postcode').value = facility.postcode;
        document.getElementById('lng').value = facility.longitude;
        document.getElementById('lat').value = facility.latitude;
        document.getElementById('contributor').value = facility.contributor;
      }
    }

    // document.getElementById('facilityForm').addEventListener('submit', (e) => {
    //   e.preventDefault();
    //   const formData = new FormData(e.target);
    //   const facilityData = Object.fromEntries(formData.entries());
    //   facilityData.id = facilityData.id ? parseInt(facilityData.id) : Date.now();

    //   // Here you'd normally send this data to your backend or update local storage
    //   console.log(facilityId ? 'Editing facility:' : 'Adding new facility:', facilityData);
    //   alert(`Facility ${facilityId ? 'updated' : 'added'} successfully!`);
    //   window.location.href = '../../dashboard.php';
    // });
  </script>
</body>
</html>
