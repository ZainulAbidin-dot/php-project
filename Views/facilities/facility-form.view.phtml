<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Facility Details</title>
  <link rel="stylesheet" href="/Views/styles/facility-form.css" />
  <link rel="stylesheet" href="/Views/styles/dashboard.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
     integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
     crossorigin=""/>
     <!-- Make sure you put this AFTER Leaflet's CSS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""></script>
</head>
<body>
  <header>
    <nav>
      <div class="logo">ecoBuddy</div>
      <button class="menu-toggle" aria-label="Toggle navigation">&#9776;</button>
      <ul class="nav-links">
        <li><a href="/categories.html">Categories</a></li>
        <li><a href="/dashboard.html">Facilities</a></li>
        <li><a href="/index.html">Logout</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <h1>Facility Details</h1>
    <div id="facilityDetails">
      <p><strong>Title:</strong> <?= htmlspecialchars($view->facility->getTitle()) ?></p>
      <p><strong>Category:</strong> <?= htmlspecialchars($view->facility->getCategory()) ?></p>
      <p><strong>Description:</strong> <?= htmlspecialchars($view->facility->getDescription()) ?></p>
      <p><strong>House Number:</strong> <?= htmlspecialchars($view->facility->getHouseNumber()) ?></p>
      <p><strong>Street Name:</strong> <?= htmlspecialchars($view->facility->getStreetName()) ?></p>
      <p><strong>County:</strong> <?= htmlspecialchars($view->facility->getCountry()) ?></p>
      <p><strong>Town:</strong> <?= htmlspecialchars($view->facility->getTown()) ?></p>
      <p><strong>Postcode:</strong> <?= htmlspecialchars($view->facility->getPostcode()) ?></p>
      <p><strong>Longitude:</strong> <?= htmlspecialchars($view->facility->getLongitude()) ?></p>
      <p><strong>Latitude:</strong> <?= htmlspecialchars($view->facility->getLatitude()) ?></p>
    </div>
  </main>

  <div id="map" style="width: 600px; height: 400px; margin: auto; margin-bottom: 10rem; z-index: 0"></div>
  <script>

    const map = L.map('map').setView([51.505, -0.09], 13);

    const tiles = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);

    const marker = L.marker([51.5, -0.09]).addTo(map)
      .bindPopup('<b>Hello world!</b><br />I am a popup.').openPopup();

    const circle = L.circle([51.508, -0.11], {
      color: 'red',
      fillColor: '#f03',
      fillOpacity: 0.5,
      radius: 500
    }).addTo(map).bindPopup('I am a circle.');

    const polygon = L.polygon([
      [51.509, -0.08],
      [51.503, -0.06],
      [51.51, -0.047]
    ]).addTo(map).bindPopup('I am a polygon.');


    const popup = L.popup()
      .setLatLng([51.513, -0.09])
      .setContent('I am a standalone popup.')
      .openOn(map);

    function onMapClick(e) {
      popup
        .setLatLng(e.latlng)
        .setContent(`You clicked the map at ${e.latlng.toString()}`)
        .openOn(map);
    }

    map.on('click', onMapClick);

  </script>



  <footer>
    <p>&copy; 2025 ecoBuddy. All rights reserved.</p>
  </footer>

  <script>
    const menuToggle = document.querySelector('.menu-toggle');
    const navLinks = document.querySelector('.nav-links');
    menuToggle.addEventListener('click', () => {
      navLinks.classList.toggle('active');
    });
  </script>
</body>
</html>
