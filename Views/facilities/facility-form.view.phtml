  <div id="map" style="width: 600px; height: 400px; margin: auto; margin-bottom: 10rem; z-index: 0"></div>
  <script>
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(function(position) {
        const latitude = position.coords.latitude;
        const longitude = position.coords.longitude;
        const map = L.map('map').setView([latitude, longitude], 10);

        L.marker([latitude, longitude]).addTo(map)
          .bindPopup('<b>Your Location</b><br />This is your current location.').openPopup();
        
        L.marker([<?= htmlspecialchars($view->facility->getLatitude()) ?>, <?= htmlspecialchars($view->facility->getLongitude()) ?>]).addTo(map)
        .bindPopup('<b>Facility Location</b><br />This is the facility location.').openPopup();


        const tiles = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

      }, function(error) {
        console.error('Error getting location:', error);
        const map = L.map('map').setView([51.505, -0.09], 13);
      });
    } else {
      console.error('Geolocation is not supported by this browser.');
      const map = L.map('map').setView([51.505, -0.09], 13);
    }

    const tiles = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
    }).addTo(map);


    function onMapClick(e) {
      popup
        .setLatLng(e.latlng)
        .setContent(`You clicked the map at ${e.latlng.toString()}`)
        .openOn(map);
    }

    map.on('click', onMapClick);
  </script>

