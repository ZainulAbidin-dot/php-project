  <script>
    function handleView(facilityId) {
        window.location.href = `/facility.view.php?facilityId=${facilityId}`;
    }

    function handleEdit(facilityId) {
        window.location.href = `/facility.edit.php?facilityId=${facilityId}`;
    }

    function handleDelete(facilityId) {
      if (confirm(`Are you sure you want to delete facility ID ${facilityId}?`)) {
        fetch('/facility.delete.php', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
          },
          body: `id=${facilityId}`
        })
        .then(response => response.text())
        .then(data => {
          location.reload();
          if (data === 'success') {
            // Remove from UI
            const rowToRemove = document.querySelector(`button.delete-btn[data-id="${facilityId}"]`).closest('tr');
            if (rowToRemove) {
              rowToRemove.remove();
            }
            alert(`Facility ${facilityId} deleted successfully`);
          } else {
            // alert('Delete failed: ' + data);
          }
        })
        .catch(error => {
          alert('Error occurred: ' + error);
        });
      }
    }

    const menuToggle = document.querySelector('.menu-toggle');
    const navLinks = document.querySelector('.nav-links');

    menuToggle.addEventListener('click', () => {
      navLinks.classList.toggle('active');
    });
  </script>

